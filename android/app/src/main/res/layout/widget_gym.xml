<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg">
    <TextView android:id="@+id/w_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Up next" android:textColor="#8b93a1" android:textSize="12sp" />
    <TextView android:id="@+id/w_next" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Open Gym App" android:textColor="#eef0f3" android:textSize="18sp" android:textStyle="bold"
        android:maxLines="1" android:ellipsize="end" android:layout_marginTop="2dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
        <TextView android:id="@+id/w_week" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="#3d8bfd" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_streak" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#f5a524" android:textSize="13sp" />
    </LinearLayout>
    <TextView android:id="@+id/w_ready" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#8b93a1" android:textSize="12sp" android:layout_marginTop="4dp" />
</LinearLayout>
